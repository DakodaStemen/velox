# Build from this checkout: cd packaging && makepkg -si
pkgname=velox
pkgver=0.1.0
pkgrel=1
pkgdesc="Fast native text and code editor built on Scintilla and Lexilla"
url='https://github.com/DakodaStemen/velox'
arch=('x86_64')
license=('GPL-3.0-or-later')
depends=('qt5-base' 'qt5-svg')
makedepends=('make' 'gcc')

build() {
  cd "$startdir/.."
  JOBS="$(nproc)" ./build.sh
}

package() {
  cd "$startdir/../build/app"
  make INSTALL_ROOT="$pkgdir" install
  install -Dm644 "$startdir/../LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/../THIRD_PARTY_NOTICES.md" "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY_NOTICES.md"
}
