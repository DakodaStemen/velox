[Desktop Entry]
Type=Application
Name=Velox
GenericName=Text Editor
Comment=Fast native text and code editor
Exec=velox %F
Icon=io.github.DakodaStemen.Velox
Terminal=false
StartupNotify=true
StartupWMClass=velox
Categories=Utility;TextEditor;
Keywords=text;editor;code;programming;
MimeType=text/plain;text/x-csrc;text/x-chdr;text/x-c++src;text/x-c++hdr;text/x-python;text/x-shellscript;text/x-makefile;text/markdown;text/x-log;text/csv;text/html;text/css;text/xml;application/xml;application/json;application/javascript;application/x-shellscript;application/x-yaml;application/toml;
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=velox --new-instance --fresh
